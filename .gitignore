# Default deny at repository root. Existing upstream tracked files stay tracked.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/CMakeLists.txt
!/main.c
!/FolderIcon.sln
!/FolderIconC.vcxproj
!/build.bat
!/build_simple.cmd
!/.github/
/.github/*
!/.github/workflows/
!/src/
/src/*
!/src/*.cpp
!/src/*.h
!/tests/
/tests/*
!/tests/*_test.cpp
!/scripts/
/scripts/*
!/scripts/build.ps1
!/scripts/check-publish.ps1
!/config/
/config/*
!/config/FolderIcon.example.ini
!/docs/
/docs/*
!/docs/PRIVACY.md
!/docs/UPSTREAM.md
!/docs/VALIDATION.md
# Existing upstream screenshots are public; do not add personal desktop captures.
!/docs/dark.png
!/docs/light.png
# Local-only configuration, personal icons, AI notes, backups, and build output.
**/.codex/
**/.claude/
**/.shared/
**/.backups/
**/dist/
**/upstream/
**/build/
**/out/
**/bin/
**/obj/
**/.zig-cache/
**/zig-out/
**/.vs/
**/.vscode/
**/node_modules/
**/__pycache__/
**/.env
**/.env.*
**/*.local.*
**/FolderIcon.ini
**/*.bak
**/*.log
**/*.lnk
**/*.ico
**/*.exe
**/*.dll
**/*.pdb
**/*.zip
**/*.7z
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/credentials*
**/secrets*