# Default deny at repository root. Existing upstream tracked files stay tracked.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/CMakeLists.txt
!/main.c
!/FolderIcon.sln
!/FolderIconC.vcxproj
!/build.bat
!/build_simple.cmd
!/.github/
/.github/*
!/.github/workflows/
!/src/
/src/*
!/src/*.cpp
!/src/*.h
!/tests/
/tests/*
!/tests/*_test.cpp
!/scripts/
/scripts/*
!/scripts/build.ps1
!/scripts/check-publish.ps1
!/config/
/config/*
!/config/FolderIcon.example.ini
!/docs/
/docs/*
!/docs/PRIVACY.md
!/docs/UPSTREAM.md
!/docs/VALIDATION.md
# Existing upstream screenshots are public; do not add personal desktop captures.
!/docs/dark.png
!/docs/light.png
# Local-only configuration, personal icons, AI notes, backups, and build output.
**/.codex/
**/.claude/
**/.shared/
**/.backups/
**/dist/
**/upstream/
**/build/
**/out/
**/bin/
**/obj/
**/cache/
**/layout/
**/*.order
**/*.fic
**/.zig-cache/
**/zig-out/
**/.vs/
**/.vscode/
**/node_modules/
**/__pycache__/
**/.env
**/.env.*
**/*.local.*
**/FolderIcon.ini
**/*.bak
**/*.log
**/*.lnk
**/*.ico
**/*.exe
**/*.dll
**/*.pdb
**/*.zip
**/*.7z
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/credentials*
**/secrets*
# Only the original application icon is public; personal icons remain excluded.
!/assets/
/assets/*
!/assets/app.ico
!/src/app.rc
!/scripts/generate-icon.ps1
!/scripts/generate-panel-badge.ps1

# Reviewed bilingual docs and explicitly approved screenshots only.
!/README.en.md
!/scripts/package-release.ps1
!/docs/RELEASE-v2.0.0-rc.1.md
!/docs/images/
/docs/images/*
!/docs/images/panel.png
!/docs/images/subfolder.png
!/docs/images/settings-appearance.png
!/docs/images/settings-entries.png
!/docs/images/real-desktop-orange.png
!/docs/images/real-shortcut-blue.png
